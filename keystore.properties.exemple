# Copiez ce fichier en « keystore.properties » (ignoré par git) et renseignez-le
# avec vos propres valeurs, puis placez la clé dans keystore/mtgduel.jks.
#
# Signer avec VOTRE clé est ce qui permet aux futures versions de s'installer
# par-dessus l'app déjà installée, sans perdre les données.
#
# Sans ce fichier, `assembleRelease` se rabat sur la clé de debug : l'APK
# s'installe, mais seulement sur un téléphone où aucune version signée
# autrement n'est déjà présente.
storeFile=keystore/mtgduel.jks
storePassword=VOTRE_MOT_DE_PASSE
keyAlias=mtgduel
keyPassword=VOTRE_MOT_DE_PASSE
